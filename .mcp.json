{
  "mcpServers": {
    "supabase": {
      "type": "http",
      "url": "https://mcp.supabase.com/mcp?project_ref=wqqsuybmyqemhojsamgq"
    },
    "resend": {
      "type": "http",
      "url": "https://mcp.resend.com/mcp"
    },
    "posthog": {
      "type": "http",
      "url": "https://mcp.posthog.com/mcp",
      "headers": {
        "Authorization": "Bearer ${POSTHOG_MCP_KEY}"
      }
    },
    "gsc": {
      "command": "npx",
      "args": ["-y", "suganthan-gsc-mcp@2.2.2"],
      "env": {
        "GSC_AUTH_MODE": "${GSC_AUTH_MODE:-oauth}",
        "GSC_OAUTH_SECRETS_FILE": "${HOME}/.config/gsc/client_secrets.json",
        "GSC_SITE_URL": "${GSC_SITE_URL:-sc-domain:openprojets.com}",
        "GSC_SITE_URLS": "${GSC_SITE_URLS:-sc-domain:openprojets.com}"
      }
    }
  }
}