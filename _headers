# Headers de sécurité et performance pour Netlify
# https://docs.netlify.com/routing/headers/

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(self), microphone=(), camera=()
  Strict-Transport-Security: max-age=63072000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Images : les logos et la couverture ne changent jamais (règles ci-dessous),
# les captures d'écran du site si, sous le même nom : une semaine, pas un an
/img/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400

/img/logos/*
  Cache-Control: public, max-age=31536000, immutable

/img/cover/*
  Cache-Control: public, max-age=2592000

# Cache immutable pour les assets Vite du site (hash dans le nom, servis
# depuis /home/assets/ par réécriture : les deux chemins portent la règle)
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/home/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Pages du site hors des moteurs : le document d'estimation (personnel), les
# guides imprimables et la page des clients Hélios. Le routeur pose aussi la
# balise robots, mais l'en-tête ne dépend pas du JavaScript.
/tarification/estimation
  X-Robots-Tag: noindex, nofollow
/aide/guide-admin
  X-Robots-Tag: noindex, nofollow
/aide/guide-contributeur
  X-Robots-Tag: noindex, nofollow
/helios
  X-Robots-Tag: noindex, nofollow

# Cache moyen pour CSS/JS (fichiers modifiés à chaque déploiement)
/styles/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/modules/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Exception : ce fichier porte la configuration de confidentialité (refus du
# visiteur, masquage, garde-fous). Avec la règle ci-dessus, un navigateur aurait
# pu servir une version périmée pendant 7 jours après une correction.
/modules/analytics.js
  Cache-Control: public, max-age=300, must-revalidate

/*.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

# Pages HTML : pas de cache (toujours servir la dernière version)
/*.html
  Cache-Control: public, max-age=0, must-revalidate

/
  Cache-Control: public, max-age=0, must-revalidate


