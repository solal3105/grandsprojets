# Netlify Redirects Configuration
# https://docs.netlify.com/routing/redirects/

# ============================================
# REDIRECTIONS DOMAINES (PRIORITAIRES)
# Les domaines doivent être configurés dans Netlify Domain Management
# ============================================

# Redirection grandsprojets.com → openprojets.com
https://grandsprojets.com/*              https://openprojets.com/:splat              301!
https://www.grandsprojets.com/*          https://openprojets.com/:splat              301!
http://grandsprojets.com/*               https://openprojets.com/:splat              301!
http://www.grandsprojets.com/*           https://openprojets.com/:splat              301!

# Autres domaines alternatifs → openprojets.com
https://openprojet.com/*                 https://openprojets.com/:splat              301!
https://www.openprojet.com/*             https://openprojets.com/:splat              301!
https://openprojets.fr/*                 https://openprojets.com/:splat              301!
https://www.openprojets.fr/*             https://openprojets.com/:splat              301!
https://openprojet.fr/*                  https://openprojets.com/:splat              301!
https://www.openprojet.fr/*              https://openprojets.com/:splat              301!

# Sous-domaines villes → ?city=
https://lumieres.openprojets.com/*       https://openprojets.com/:splat?city=lumieres   301!
https://lumieres.grandsprojets.com/*     https://openprojets.com/:splat?city=lumieres   301!

# ============================================
# REDIRECTIONS CUSTOM (CHEMINS)
# ============================================

# Redirections custom (prioritaires)
/bilan              /?city=rassemblees    200

# Redirections auto vers villes (ajouter au fur et à mesure)
/metropole-lyon     /?city=metropole-lyon 200
/divonne            /?city=divonne        200
/rassemblees        /?city=rassemblees    200

# Routes exclues - ne pas rediriger (déjà gérées par le serveur)
/fiche/*            /fiche/:splat         200
/login/*            /login/:splat         200
/logout/*           /logout/:splat        200
/assistant-ia/*     /assistant-ia/:splat  200

# Home (Vue SPA) — assets servis depuis _home/, SPA fallback pour le routing
/home/assets/*      /_home/assets/:splat  200!
/home/img/*         /_home/img/:splat     200!
/home               /_home/index.html     200!
/home/*             /_home/index.html     200!

# Ancienne landing-page redirigée vers /home
/landing-page       /home/                    301
/landing-page/*     /home/                    301

# Fallback : toute autre route non définie redirige vers la racine
# (sera géré par le JavaScript côté client si c'est une ville valide)
/*                  /index.html           200
